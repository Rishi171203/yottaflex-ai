# --- General / application ---
APP_TITLE=YottaFlex Routing & SLA API
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Database (Postgres 16). docker compose wires the same values. ---
DATABASE_URL=postgresql+psycopg2://yottaflex:yottaflex_dev@localhost:5432/yottaflex
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yottaflex
POSTGRES_USER=yottaflex
POSTGRES_PASSWORD=yottaflex_dev
POSTGRES_TEST_DSN=            # exported in CI/eval runs only; unset = integration tests skip

# --- Datagen ---
DATAGEN_SEED=20261022
